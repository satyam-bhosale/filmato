{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "cache": true,
            "outputs": ["dist/**", ".next/**"]
        },
        "dev": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false
        },
        "start": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false
        },
        "android": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false
        },
        "ios": {
            "dependsOn": ["^build"],
            "persistent": true,
            "cache": false
        }
    }
}